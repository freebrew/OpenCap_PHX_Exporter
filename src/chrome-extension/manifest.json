{
  "manifest_version": 3,
  "name": "OpenCap Data Exporter",
  "short_name": "OpenCap",
  "version": "3.2.4",
  "description": "Export FieldCap job, crew, BHA, inventory, and daily slide/rotate metres to CSV using your login.",
  "author": "PHX OpenCap",
  "homepage_url": "https://freebrew.github.io/OpenCap_PHX_Exporter/",
  "minimum_chrome_version": "116",
  "permissions": [
    "downloads",
    "storage",
    "activeTab",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "https://fieldcap-cdn.phxtech.com/*",
    "*://*.phxtech.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.phxtech.com/*"
      ],
      "js": [
        "browser-api.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected-spy.js"
      ],
      "matches": [
        "*://*.phxtech.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": ".OpenCap Exporter",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
