// Reads the Windows Arial fonts (regular, bold, italic, bold italic) and writes src/arialGlyphs.ts:
// the outline fingerprint of each Latin, punctuation and maths glyph with its character. Import
// Plan and Import AC use it to read PDFs whose embedded Arial has no letter map (glyphShape.ts).
// Only fingerprints are written, never outlines. Run: node scripts/gen-arial-glyphs.mts
import { readFileSync, writeFileSync } from "node:fs";
import { fingerprintTable, packFingerprints, readGlyphFont, type GlyphFont } from "../src/glyphShape.ts";

const FONT_DIR = process.env.ARIAL_DIR ?? "C:/Windows/Fonts";
const FILES = ["arial.ttf", "arialbd.ttf", "ariali.ttf", "arialbi.ttf"];
const RANGES: Array<[number, number]> = [
  [0x20, 0x7e],
  [0xa0, 0x17f],
  [0x2010, 0x203a],
  [0x20ac, 0x20ac],
  [0x2100, 0x2122],
  [0x2190, 0x2195],
  [0x2202, 0x2265],
];

const fonts: GlyphFont[] = FILES.map((file) => {
  const font = readGlyphFont(new Uint8Array(readFileSync(`${FONT_DIR}/${file}`)));
  if (!font) throw new Error(`${file} is not a TrueType font with outlines.`);
  return font;
});
const keep = (code: number) => RANGES.some(([low, high]) => code >= low && code <= high);
const { table, clashes } = fingerprintTable(fonts, keep);
const out = new URL("../src/arialGlyphs.ts", import.meta.url);
writeFileSync(out, [
  `// GENERATED by scripts/gen-arial-glyphs.mts from the Arial fonts (${FILES.join(", ")}). Do not edit.`,
  "// Each entry is a 16-hex glyph outline fingerprint followed by its character (glyphShape.ts).",
  `export const ARIAL_GLYPHS = ${JSON.stringify(packFingerprints(table))};`,
  "",
].join("\n"));
process.stdout.write(`arialGlyphs.ts: ${table.size} fingerprints from ${FILES.length} fonts. Shared outlines (first kept): ${clashes.length ? clashes.join(" ") : "none"}\n`);
