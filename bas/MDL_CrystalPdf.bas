Attribute VB_Name = "MDL_CrystalPdf"
Option Explicit

' GENERATED by bas\_embed_crystal_decoder.ps1 from bas\_crystal_pdf_text.cs. Do not edit by hand.
'
' Crystal Reports Compass PDFs embed Arial as Identity-H with no Unicode map, so pdftotext
' returns glyph numbers. The decoder matches each glyph outline to the system Arial fonts.
' It is C#, compiled by PowerShell Add-Type, and it is carried in this module so the
' workbook does not depend on any file beside it.

Public Function CrystalPdfText(ByVal pdfPath As String) As String
    Dim tmpDir As String: tmpDir = Environ("TEMP")
    Dim csPath As String: csPath = tmpDir & "\oc_crystal_pdf.cs"
    Dim psPath As String: psPath = tmpDir & "\oc_crystal_pdf.ps1"
    Dim outPath As String: outPath = tmpDir & "\oc_crystal_pdf.txt"
    CrystalDeleteQuiet csPath: CrystalDeleteQuiet psPath: CrystalDeleteQuiet outPath

    On Error GoTo Done
    CrystalWriteFile csPath, CrystalDecoderSource()
    CrystalWriteFile psPath, CrystalLauncherSource()
    Dim sh As Object: Set sh = CreateObject("WScript.Shell")
    sh.Run "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File """ & psPath & _
           """ """ & pdfPath & """ """ & outPath & """", 0, True
    If Dir(outPath) <> "" Then CrystalPdfText = CrystalReadFile(outPath)
Done:
    CrystalDeleteQuiet csPath: CrystalDeleteQuiet psPath: CrystalDeleteQuiet outPath
End Function

' True when the text is glyph numbers (control characters), which is what pdftotext gives for
' a Crystal Reports PDF. Used to say so when the decoder could not run.
Public Function PdfTextIsGlyphNumbers(ByVal pdfText As String) As Boolean
    Dim n As Long, Bad As Long, i As Long, c As Long
    n = Len(pdfText): If n > 4000 Then n = 4000
    For i = 1 To n
        c = AscW(mid$(pdfText, i, 1))
        If c >= 0 And c < 32 Then
            If c <> 9 And c <> 10 And c <> 12 And c <> 13 Then Bad = Bad + 1
        End If
    Next i
    PdfTextIsGlyphNumbers = (n > 0 And Bad * 20 > n)
End Function

Private Sub CrystalDeleteQuiet(ByVal path As String)
    On Error Resume Next
    Kill path
End Sub

Private Sub CrystalWriteFile(ByVal path As String, ByVal body As String)
    Dim f As Integer: f = FreeFile
    Open path For Output As #f
    Print #f, body;
    Close #f
End Sub

' Binary read: Line Input stops at Ctrl+Z, a byte that is a glyph number in these fonts.
Private Function CrystalReadFile(ByVal path As String) As String
    Dim f As Integer: f = FreeFile
    Dim s As String
    Open path For Binary Access Read As #f
    If LOF(f) > 0 Then
        s = Space$(LOF(f))
        Get #f, , s
    End If
    Close #f
    CrystalReadFile = Replace(s, vbCr, "")
End Function

Private Function CrystalLauncherSource() As String
    Dim s As String
    s = s & "param([string]$Pdf, [string]$Out)" & vbLf
    s = s & "$ErrorActionPreference = ""Stop""" & vbLf
    s = s & "$here = Split-Path -Parent $MyInvocation.MyCommand.Path" & vbLf
    s = s & "Add-Type -Path (Join-Path $here ""oc_crystal_pdf.cs"") -ReferencedAssemblies ""System.IO.Compression""" & vbLf
    s = s & "[CrystalPdf.Decoder]::WriteText($Pdf, $Out)" & vbLf
    CrystalLauncherSource = s
End Function

